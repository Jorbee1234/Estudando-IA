@Api_HostAddress = http://localhost:5164

GET {{Api_HostAddress}}/api/health
Accept: application/json

###

POST {{Api_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@example.com",
  "password": "Senha@1234"
}

###

# @name login
POST {{Api_HostAddress}}/api/tokens
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "Senha@1234"
}

###

GET {{Api_HostAddress}}/api/users/me
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Feed (the seed creates julio@example.com, ana@example.com and marcos@example.com, password Senha@1234)

GET {{Api_HostAddress}}/api/posts?limit=6&sort=popular
Accept: application/json

###

GET {{Api_HostAddress}}/api/posts?q=acess&tags=React&tags=Front-end
Accept: application/json

###

GET {{Api_HostAddress}}/api/tags
Accept: application/json

###

# @name seedLogin
POST {{Api_HostAddress}}/api/tokens
Content-Type: application/json

{
  "email": "julio@example.com",
  "password": "Senha@1234"
}

###

# @name newPost
POST {{Api_HostAddress}}/api/posts
Content-Type: application/json
Authorization: Bearer {{seedLogin.response.body.$.accessToken}}

{
  "title": "Meu novo projeto",
  "description": "Descrição do projeto.",
  "tags": ["React", "CSS"]
}

###

PUT {{Api_HostAddress}}/api/posts/{{newPost.response.body.$.id}}/likes/me
Authorization: Bearer {{seedLogin.response.body.$.accessToken}}

###

POST {{Api_HostAddress}}/api/posts/{{newPost.response.body.$.id}}/comments
Content-Type: application/json
Authorization: Bearer {{seedLogin.response.body.$.accessToken}}

{
  "body": "Primeiro comentário!"
}

###
