# Copie para .env e preencha. Nunca commite valores reais.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rotalog
DB_USER=
DB_PASSWORD=
DB_SCHEMA=entregas

JWT_SECRET=

API_FROTAS_URL=http://localhost:8080/api
API_NOTIFICACOES_URL=http://localhost:5000

# Integrações HTTP (padrão: 5000 ms e 1 retry, só em GET)
HTTP_TIMEOUT_MS=5000
HTTP_RETRIES=1

# Origens permitidas no CORS, separadas por vírgula (padrão: painel-admin e rastreamento locais).
# `*` libera qualquer origem.
CORS_ORIGINS=http://localhost:4200,http://localhost:3001

# Limite do body JSON, health check (timeout por dependência) e encerramento (tempo máximo)
BODY_LIMIT=100kb
HEALTH_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Rate limit por IP de GET /api/rastreamento/pedido/:numero (portal público)
RATE_LIMIT_PEDIDO_MAX=60
RATE_LIMIT_PEDIDO_JANELA_MS=60000
