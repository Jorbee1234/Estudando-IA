{
  "name": "rastreamento-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rastreamento-e2e/src",
  "implicitDependencies": ["rastreamento"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/rastreamento-e2e/playwright.config.ts"
      }
    },
    "e2e-atualizar-capturas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/rastreamento-e2e/playwright.config.ts --update-snapshots"
      }
    }
  }
}
