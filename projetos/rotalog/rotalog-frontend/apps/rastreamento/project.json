{
  "name": "rastreamento",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rastreamento/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/rastreamento",
        "index": "apps/rastreamento/src/index.html",
        "main": "apps/rastreamento/src/main.tsx",
        "tsConfig": "apps/rastreamento/tsconfig.app.json",
        "assets": [
          "apps/rastreamento/src/favicon.ico",
          "apps/rastreamento/src/assets"
        ],
        "styles": [],
        "scripts": [],
        "webpackConfig": "@nx/react/plugins/webpack"
      }
    },
    "serve": {
      "executor": "@nx/webpack:dev-server",
      "configurations": {
        "development": {
          "buildTarget": "rastreamento:build",
          "hmr": true,
          "port": 3001
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/rastreamento/src/**/*.{ts,tsx}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/rastreamento/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/rastreamento/tsconfig.app.json"
      }
    }
  },
  "tags": []
}